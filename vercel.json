{
  "functions": {
    "api/index.mjs": {
      "maxDuration": 60
    }
  },
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "/api/index?__path=:path*"
    },
    {
      "source": "/((?!assets/|api/).*)",
      "destination": "/index.html"
    }
  ],
  "redirects": [
    {
      "source": "/secteurs/tourisme",
      "destination": "/secteurs/tourisme-hotellerie-restauration",
      "permanent": true
    },
    {
      "source": "/secteurs/enseignement",
      "destination": "/secteurs/enseignement-prive",
      "permanent": true
    },
    {
      "source": "/sante",
      "destination": "/secteurs/sante",
      "permanent": true
    },
    {
      "source": "/concierge",
      "destination": "/account-manager",
      "permanent": true
    },
    {
      "source": "/concierge/:path*",
      "destination": "/account-manager/:path*",
      "permanent": true
    },
    {
      "source": "/admin/concierges",
      "destination": "/admin/account-managers",
      "permanent": true
    }
  ]
}
