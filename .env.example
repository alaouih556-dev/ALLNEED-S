# ALLNEEDS V46
ALLNEEDS_FRONTEND_ORIGIN=http://127.0.0.1:5176
ALLNEEDS_PUBLIC_URL=http://127.0.0.1:5176
ALLNEEDS_SESSION_SECRET=CHANGE_ME_WITH_AT_LEAST_32_RANDOM_CHARACTERS
# Heures d’inactivité avant déconnexion (renouvelée à chaque visite). Défaut : 8
ALLNEEDS_SESSION_TTL_HOURS=720
ALLNEEDS_DATA_DIR=backend/data

# Premier administrateur — retirez le mot de passe après le premier démarrage confirmé
ALLNEEDS_ADMIN_EMAIL=admin@votre-domaine.ma
ALLNEEDS_ADMIN_NAME=Administrateur ALLNEEDS
ALLNEEDS_ADMIN_PASSWORD=CHANGE_ME_MINIMUM_12_CHARACTERS

# Compte de présentation commerciale (créé ou mis à jour au démarrage, sans doublon)
# Le mot de passe n'est jamais stocké en clair : seule son empreinte scrypt est enregistrée.
# Laissez ALLNEEDS_SALES_PASSWORD vide pour ne rien créer ; retirez-le après le premier démarrage confirmé.
ALLNEEDS_SALES_EMAIL=sales_presentation@gmail.com
ALLNEEDS_SALES_NAME=Présentation commerciale
ALLNEEDS_SALES_PASSWORD=

# Gmail SMTP
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=yourgmail@gmail.com
EMAIL_PASS=GOOGLE_APP_PASSWORD
EMAIL_FROM=yourgmail@gmail.com
EMAIL_FROM_NAME=ALLNEEDS

# Supabase relationnel — backend uniquement
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=sb_secret_xxxxxxxxxxxxxxxxx

# Studio IA — clé Magnific, backend uniquement (ne jamais la préfixer par VITE_)
MAGNIFIC_API_KEY=
# Bucket privé Supabase des fichiers clients et des générations. Défaut : allneeds-private
ALLNEEDS_STORAGE_BUCKET=allneeds-private

# Secteurs visibles dans l’interface (séparés par des virgules). Défaut : sante
# Exemple pour tout réactiver : VITE_ACTIVE_SECTORS=sante,enseignement,tourisme
VITE_ACTIVE_SECTORS=sante
