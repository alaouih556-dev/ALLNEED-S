# --------------------------------------------------------------------------- #
# Frontend (Vite) — aucune valeur secrète ici.
# --------------------------------------------------------------------------- #

# Origine de l'API. Vide = même origine : en développement le proxy Vite
# (/api → VITE_API_PROXY) s'en charge, en production la réécriture de l'hébergeur.
VITE_API_BASE=

# Cible du proxy /api en mode `npm run dev`.
VITE_API_PROXY=http://127.0.0.1:8787

# Lien de l'espace métier Santé externe affiché dans « Espace métier ».
VITE_HEALTH_URL=

# --------------------------------------------------------------------------- #
# API (server/index.mjs)
# --------------------------------------------------------------------------- #

PORT=8787
HOST=127.0.0.1

# Dossier des données JSON de l'API (créé au premier démarrage).
DATA_DIR=./server/data

# Environnement déclaré par l'API (GET /api/health). « demo » affiche le
# rappel des comptes de démonstration sur la page de connexion.
APP_ENV=demo

# Origines autorisées en CORS, séparées par des virgules.
CORS_ORIGIN=http://localhost:5173,http://localhost:4173

# « 1 » ajoute le drapeau Secure aux cookies de session : obligatoire derrière
# HTTPS (laisser vide en local).
COOKIE_SECURE=
