}


function orgForUser(user) {
  if (!user || user.role === 'admin' || user.role === 'concierge' || user.role === 'prestataire') return null
  return db.orgs.find((org) => Array.isArray(user.orgIds) && user.orgIds.includes(org.id)) || null
